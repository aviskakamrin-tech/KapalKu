{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:admin": "vite --mode admin",
    "dev:officer": "vite --mode officer",
    "dev:passenger": "vite --mode passenger",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:client": "vite build",
    "build:admin": "vite build --mode admin",
    "build:officer": "vite build --mode officer",
    "build:passenger": "vite build --mode passenger",
    "build:apps:admin": "vite build apps/admin",
    "build:apps:officer": "vite build apps/petugas",
    "build:apps:passenger": "vite build apps/pengguna",
    "deploy:admin": "npm run build:admin && npx wrangler pages deploy dist --project-name=kapalku-admin",
    "deploy:officer": "npm run build:officer && npx wrangler pages deploy dist --project-name=kapalku-petugas",
    "deploy:passenger": "npm run build:passenger && npx wrangler pages deploy dist --project-name=kapalku-penumpang",
    "preview": "vite preview",
    "preview:admin": "vite preview --mode admin",
    "preview:officer": "vite preview --mode officer",
    "preview:passenger": "vite preview --mode passenger",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.117.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
